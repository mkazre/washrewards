APP_NAME="WashRewards SA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sail (docker compose) defaults — matches compose.yaml's mysql/redis services.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@washrewards.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# AWS — af-south-1 (Cape Town) for POPIA data residency. Used for S3 media
# storage and (once switched on in the admin Settings page) SNS SMS for OTP
# delivery — the same credentials cover both, no separate SNS keys needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Fallback OTP/payment drivers used only before the platform_settings row
# exists (first boot / artisan commands outside a request). Once the app is
# running, the admin Settings page's "Integrations & payments" section is
# the actual source of truth — see PlatformSetting::effectiveSmsDriver() /
# effectivePaymentGateway(). Real gateway credentials (PayFast/Paystack/Ozow)
# live in that Settings page too, not here — they're business/merchant
# secrets, not infra config.
SMS_DRIVER=sandbox
PAYMENT_GATEWAY=sandbox

VITE_APP_NAME="${APP_NAME}"
